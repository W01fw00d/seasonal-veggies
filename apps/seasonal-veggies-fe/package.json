{
  "name": "@seasonal-veggies/fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:api": "openapi-ts -i ../seasonal-veggies-be/openapi.json -o src/api -p @hey-api/typescript",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "npm run coverage",
    "test:unit": "vitest run src --exclude \"**/*.spec.tsx\"",
    "test:unit:coverage": "vitest run src --exclude \"**/*.spec.tsx\" --coverage.enabled --coverage.provider=v8 --coverage.reporter=json --coverage.reportsDirectory=coverage/vitest",
    "test:components": "playwright test --project=components",
    "test:components:ui": "playwright test --project=components --ui",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e:ui": "playwright test --project=e2e --ui",
    "test:playwright:coverage": "playwright test",
    "coverage": "npm run test:unit:coverage && npm run test:playwright:coverage && node scripts/merge-coverage.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.12",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "oxlint": "^1.81.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "typescript": "~6.0.2",
    "v8-to-istanbul": "^9.3.0",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  }
}
