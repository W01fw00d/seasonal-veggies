{
  "name": "seasonal-veggies",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:fe": "npm run dev --workspace=@seasonal-veggies/fe",
    "dev:be": "npm run start:dev --workspace=@seasonal-veggies/be",
    "build:fe": "npm run build --workspace=@seasonal-veggies/fe",
    "build:be": "npm run build --workspace=@seasonal-veggies/be",
    "build": "npm run build:fe && npm run build:be",
    "lint": "npm run lint --workspace=@seasonal-veggies/fe && npm run lint --workspace=@seasonal-veggies/be",
    "test": "npm run coverage --workspace=@seasonal-veggies/fe",
    "test:unit": "npm run test:unit --workspace=@seasonal-veggies/fe",
    "test:components": "npm run test:components --workspace=@seasonal-veggies/fe",
    "test:e2e": "npm run test:e2e --workspace=@seasonal-veggies/fe"
  }
}
